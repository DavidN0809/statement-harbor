#!/usr/bin/env bash
# Generated by tools/make_unix_launchers.py - edit the .bat and re-run.
set -euo pipefail
cd "$(dirname "$0")"

# No argument = your account. An argument = that named account, e.g.
#   ./login.command spouse   ->  --config config.spouse.json
CFG=""
if [ "${1:-}" != "" ]; then CFG="--config config.$1.json"; fi

# This app's own Python when ./setup.command made one. Otherwise, in a
# checkout, the one setup-all.command made for every app in gui/.venv.
PY=.venv/bin/python
if [ ! -x "$PY" ]; then
    PY=../../gui/.venv/bin/python
    if [ ! -x "$PY" ] || ! "$PY" -c 'import importlib.util as u, sys; sys.exit(not all(map(u.find_spec, ["paperpull_core", "playwright", "pypdf"])))' >/dev/null 2>&1; then
        if [ -f ../../setup-all.command ]; then
            echo "This app is not set up yet. Run setup-all.command in the PaperPull folder first."
        else
            echo "This app is not set up yet - run ./setup.command first."
        fi
        exit 1
    fi
fi

echo '============================================================'
echo 'Uber Receipts - sign in'
echo '============================================================'
echo 'A browser window will open on your Uber trips'
echo '1. Sign in there, and answer any code Uber sends yourself'
echo '2. For Uber Eats orders, open ubereats.com/orders in a second tab'
echo 'and sign in there too. It is a separate sign-in'
echo '3. LEAVE THAT BROWSER WINDOW OPEN, do not close it'

"$PY" uber_receipts.py --open-browser $CFG
